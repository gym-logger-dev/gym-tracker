{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "rootDir": ".",
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["jest"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["app", "src", "packages", "tests", "app.config.ts", "expo-env.d.ts"],
  "exclude": ["node_modules"]
}
